{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local reader window: app-owned book bytes and graceful window close only.",
  "windows": ["main"],
  "permissions": [
    "book-file-store",
    "book-export",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
