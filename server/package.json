{
  "name": "book-tracking-sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker sync backend for book-tracking-app (push/pull change log over D1, gated by Access).",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply book_reader_sync --local",
    "migrate": "wrangler d1 migrations apply book_reader_sync --remote"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
