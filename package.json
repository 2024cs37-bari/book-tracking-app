{
  "name": "book-tracking-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, cross-device personal book reader and library tracker",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "corpus:fetch": "tsx tooling/fetch-corpus.ts",
    "test:corpus": "playwright test --config playwright.corpus.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run test && npm run build",
    "check:server": "npm --prefix server run typecheck && npm --prefix server test",
    "check:all": "npm run check && npm run check:server",
    "audit:production": "npm audit --omit=dev && npm --prefix server audit --omit=dev",
    "test:sync-browser": "playwright test --config playwright.sync.config.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib --locked",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "docs:check": "tsx tooling/check-doc-links.ts"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@tauri-apps/api": "^2.12.4",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "pdfjs-dist": "5.4.624",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "27.4.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
